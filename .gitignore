nlp/
.ipynb_checkpoints/
__pycache__/
# big files ignored, but DVC's small pointer files (*.dvc) are committed
data/**
!data/**/
!data/**/*.dvc
# metrics (cache: false) are committed to git
!data/processed/*_report.json

# the "!<dir>/**/" line is needed: DVC skips any folder git ignores, so without it DVC never sees the .dvc files inside
models/**
!models/**/
!models/*.dvc
predictions/

logs/
artifacts/
.env